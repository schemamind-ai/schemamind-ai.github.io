---
import type { Person } from '../data/people';

interface Props {
  title: string;
  people: Person[];
}

const { title, people } = Astro.props;
---

<div class="group">
  <h3>{title}</h3>
  <ul>
    {
      people.map((person) => (
        <li>
          <span class="name">{person.name}</span>
          {person.department && <span class="department">{person.department}</span>}
        </li>
      ))
    }
  </ul>
</div>

<style>
  h3 {
    padding-bottom: var(--space-1);
    border-bottom: 1px solid var(--rule-strong);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-muted);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--rule);
  }

  .name {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.1875rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .department {
    display: block;
    margin-top: 0.15rem;
    color: var(--text-muted);
    font-size: 0.875rem;
  }
</style>
